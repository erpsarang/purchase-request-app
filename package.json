{
  "name": "purchase-request-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"require('@sap/cds').load('*').then(m=>{if(!m||!m.definitions)process.exit(1)})\"",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1"
  },
  "cds": {
    "folders": {
      "db": "src/db",
      "srv": "src/srv"
    }
  }
}
